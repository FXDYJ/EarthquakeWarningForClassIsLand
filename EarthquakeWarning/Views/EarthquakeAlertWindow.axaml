<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EarthquakeWarning.Views" x:Class="EarthquakeWarning.Views.EarthquakeAlertWindow"
        Title="地震预警" SystemDecorations="None" Topmost="True" Background="#090C12" Foreground="#F3F5F8"
        FontFamily="Microsoft YaHei UI, Segoe UI" Width="1600" Height="900" MinWidth="800" MinHeight="500">
    <Window.Styles>
        <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#B4BECF"/><Setter Property="FontSize" Value="17"/></Style>
        <Style Selector="Button"><Setter Property="Background" Value="#242B37"/><Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontSize" Value="18"/></Style>
        <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="#F3F5F8"/><Setter Property="BorderThickness" Value="2"/></Style>
        <Style Selector="ToggleButton"><Setter Property="Background" Value="#242B37"/><Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="BorderBrush" Value="#2B3445"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style Selector="ToggleButton:checked"><Setter Property="Background" Value="#344051"/><Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="BorderBrush" Value="#B4BECF"/></Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#344051"/><Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="BorderBrush" Value="#B4BECF"/></Style>
    </Window.Styles>
    <Viewbox Stretch="Uniform">
        <Grid x:Name="DesignCanvas" Width="1600" Height="900" RowDefinitions="88,*,136,34">
            <Border Background="{Binding Header}" Padding="28,14">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" Margin="22,0,24,0" VerticalAlignment="Center">
                        <Border BorderBrush="#F3F5F8" BorderThickness="1" Padding="12,4" IsVisible="{Binding IsDrill}">
                            <TextBlock Text="演练 · 模拟数据" FontSize="18" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Verification}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding MuteLabel}" Click="MuteClick" ToolTip.Tip="静音本次预警（M）" AutomationProperties.AutomationId="AlertMute"/>
                        <Button Content="关闭 · Esc" Click="DismissClick" AutomationProperties.AutomationId="AlertDismiss"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="342,*,282" Margin="28,18,28,16" ColumnSpacing="22">
                <Border x:Name="LocalPanel" Background="#111722" Padding="20,16">
                    <Grid RowDefinitions="Auto,190,Auto,Auto,Auto,*">
                        <TextBlock Text="{Binding Phase}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Accent}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Countdown}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="{Binding CountdownFontSize}"
                                       FontWeight="Bold" Foreground="{Binding Accent}" LineHeight="184" AutomationProperties.AutomationId="AlertCountdown"/>
                            <TextBlock Text="{Binding CountdownUnit}" FontSize="27" VerticalAlignment="Bottom" Margin="0,0,0,28"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding ForecastDetail}" Classes="caption" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <Border Grid.Row="3" BorderBrush="#2B3445" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,16">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="128,*">
                                <TextBlock Grid.ColumnSpan="2" Text="本地预估烈度（度）" FontSize="20"/>
                                <TextBlock Grid.Row="1" Text="{Binding Intensity}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="75" FontWeight="Bold" Foreground="{Binding Accent}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Impact}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ImpactDetail}" Classes="caption" FontSize="15" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4" ColumnDefinitions="*,*,*">
                            <StackPanel Spacing="5"><TextBlock Text="震级 M" Classes="caption" FontSize="15"/><TextBlock Text="{Binding Magnitude}" FontSize="32" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="距离 km" Classes="caption" FontSize="15"/><TextBlock Text="{Binding Distance}" FontSize="32" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="深度 km" Classes="caption" FontSize="15"/><TextBlock Text="{Binding Depth}" FontSize="32" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="5" Text="{Binding EventDetails}" FontSize="13" Foreground="#A4B3CB" VerticalAlignment="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Place}" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="78" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Place}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,5,0,0">
                            <TextBlock Text="震中 · 发震时间" Classes="caption" FontSize="16"/>
                            <TextBlock Text="{Binding Time}" Classes="caption" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#111A27" ClipToBounds="True" MinHeight="250">
                        <Grid><local:SeismicMap x:Name="WaveMap"/></Grid>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBlock x:Name="MapLegend" FontSize="12" Foreground="#B4BECF" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="放大" Click="ZoomIn" Padding="10,5" FontSize="14" AutomationProperties.AutomationId="MapZoomIn"/>
                            <Button Content="缩小" Click="ZoomOut" Padding="10,5" FontSize="14" AutomationProperties.AutomationId="MapZoomOut"/>
                            <Button Content="复位" Click="FitMap" Padding="10,5" FontSize="14" ToolTip.Tip="显示震中与本地" AutomationProperties.AutomationId="MapFit"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Grid.Column="2" Background="#111722" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="7" Margin="0,0,0,12">
                            <TextBlock Text="接收证据" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EvidenceSummary}" Classes="caption" FontSize="14"/>
                            <ToggleButton Content="{Binding EvidenceDetailsLabel}" IsChecked="{Binding ShowEvidence, Mode=TwoWay}" FontSize="14" Padding="12,7"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="AlertEvidence"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#2B3445" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="16" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Parameters}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4" Margin="0,6,0,0" IsVisible="{Binding ShowDetails}">
                                                <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="#B4BECF" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Publisher}" FontSize="13" Foreground="#9EABC1" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Text="多个接口可能共享上游，不代表独立台站观测" FontSize="13" Foreground="#B4BECF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="SafetyBand" Grid.Row="2" Background="{Binding Surface}" Padding="28,18">
                <Grid ColumnDefinitions="390,*" VerticalAlignment="Center">
                    <StackPanel Spacing="7" Margin="0,0,28,0">
                        <TextBlock Text="{Binding Guidance}" FontSize="31" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SecondaryAdvice}" FontSize="17" Foreground="#E2E8F2" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SafetySteps}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="46,*" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Viewbox Width="33" Height="38" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Path Data="{Binding Icon}" Stroke="#F3F5F8" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="26" Height="26"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontSize="39" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="16" Foreground="#E2E8F2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="28,0" VerticalAlignment="Center">
                <TextBlock Text="本地烈度与到达时间为模型估算，请以官方信息及现场情况为准" FontSize="13" Foreground="#B4BECF"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="北京时间" FontSize="13" Foreground="#B4BECF"/><TextBlock Text="{Binding Clock}" FontSize="13" Foreground="#B4BECF"/></StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
