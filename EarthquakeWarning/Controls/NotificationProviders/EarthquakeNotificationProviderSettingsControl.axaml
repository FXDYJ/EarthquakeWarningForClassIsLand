<ci:NotificationProviderControlBase
    x:Class="EarthquakeWarning.Controls.NotificationProviders.EarthquakeNotificationProviderSettingsControl"
    x:TypeArguments="models:EarthquakeNotificationSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="clr-namespace:EarthquakeWarning.Controls.NotificationProviders"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:models="clr-namespace:EarthquakeWarning.Models"
    mc:Ignorable="d"
    d:DesignHeight="560" d:DesignWidth="450">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:EarthquakeNotificationProviderSettingsControl}}">

            <ui:InfoBar Title="免责声明"
                        Margin="0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="综合模式等待 CENC 直连正式测定，与另一接收路径的预警严格吻合后才升级；可能错过提前量。接口可能共享上游，仍不能保证零误报。" />

            <ui:SettingsExpander Header="地震监测" IconSource="Cloud" Description="{Binding Settings.ServerInfo}" IsExpanded="True">
                <ui:SettingsExpanderItem Content="启用监测与告警">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.MonitoringEnabled}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="数据来源">
                    <ui:SettingsExpanderItem.Footer>
                        <ComboBox Width="250" ItemsSource="{Binding SourceOptions}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding Settings.SourceMode}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="确认后全屏" Description="在 CI 所在屏幕显示；Esc 可关闭，同一事件不会反复弹窗">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.EnableFullScreen}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <TextBlock Text="单接口模式仅用于查看与 CI 提示。综合模式核对发震时间、震中、震级和可用深度；Wolfx 的推送与 HTTP 合并计数。" TextWrapping="Wrap" Margin="12"/>
                <Expander Header="各接口连接详情" Margin="12"><TextBlock Text="{Binding Settings.SourceStatus}" TextWrapping="Wrap"/></Expander>
            </ui:SettingsExpander>

            <TextBlock Text="服务状态"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <ui:SettingsExpander Header="最近震情记录"
                                 Margin="0"
                                 IconSource="Cloud"
                                 Description="{Binding Settings.ServerInfo}">
                <ui:SettingsExpanderItem Content="当前数据"
                                         Description="{Binding Settings.Info}" />
                <TextBlock Text="{Binding Settings.RecentReports}" Margin="12" TextWrapping="Wrap"/>
            </ui:SettingsExpander>

            <TextBlock Text="预警配置"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <ui:SettingsExpander Header="地理位置"
                                 Margin="0"
                                 IconSource="Target"
                                 Description="用于计算本地烈度和预计到达时间"
                                 IsExpanded="True">
                <ui:SettingsExpander.Footer>
                    <Button Content="自动定位"
                            Click="btnLocate_Click"
                            x:Name="btnLocate" />
                </ui:SettingsExpander.Footer>

                <ui:SettingsExpanderItem Content="纬度">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.Latitude}"
                                       Minimum="-90" Maximum="90"
                                       Increment="0.001"
                                       FormatString="0.######" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="经度">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.Longitude}"
                                       Minimum="-180" Maximum="180"
                                       Increment="0.001"
                                       FormatString="0.######" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:InfoBar x:Name="locationErrorInfoBar"
                        Margin="0"
                        Title="无法自动定位"
                        Message="请确认系统位置服务已开启，并允许 ClassIsland 访问位置信息。"
                        Severity="Warning"
                        IsOpen="False"
                        IsClosable="True" />

            <ui:SettingsExpander Header="烈度阈值"
                                 Margin="0"
                                 IconSource="Filter"
                                 Description="本地预估烈度超过该值时弹出提醒">
                <ui:SettingsExpander.Footer>
                    <NumericUpDown Width="150"
                                   Value="{Binding Settings.Threshold}"
                                   Minimum="0" Maximum="12"
                                   Increment="0.1"
                                   FormatString="0.0" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="地图与地名" IconSource="Target" Description="在线地图支持随缩放显示省市、区县和街道；断网保留离线行政区与城市地名">
                <ui:SettingsExpanderItem Content="启用在线地图">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.EnableOnlineMap}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="瓦片地址" Description="HTTPS，256 像素瓦片，包含 {z}/{x}/{y}">
                    <ui:SettingsExpanderItem.Footer><TextBox Width="260" Text="{Binding Settings.MapTileTemplate}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="地图署名">
                    <ui:SettingsExpanderItem.Footer><TextBox Width="260" Text="{Binding Settings.MapAttribution}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="台站观测（TREM）" IconSource="Cloud" Description="台湾地区实时震动指标；独立展示，不参与预警触发">
                <ui:SettingsExpanderItem Content="启用台站观测" Description="随监测总开关暂停；需要联网">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.EnableStationMonitoring}" AutomationProperties.AutomationId="EnableStationMonitoring"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <TextBlock Text="{Binding Settings.StationStatus}" TextWrapping="Wrap" Margin="12"/>
                <Button Content="查看台站地图与观测值" Click="OpenStations" Margin="12,0,12,12" AutomationProperties.AutomationId="OpenStationMonitor"/>
                <TextBlock Text="数据：ExpTech Studio TREM · 非商业用途 · 非官方信息，以中央气象署发布为准。观测震度非中国本地预估烈度，不提供原始波形。" TextWrapping="Wrap" Margin="12"/>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="地震信息与倒计时语音"
                                 Margin="0"
                                 IconSource="Volume"
                                 Description="先说明地震与避险方式，再报预计到达秒数；最后 10 秒暂停详情，逐秒倒数">
                <ui:SettingsExpanderItem Content="启用语音播报">
                    <ui:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsSpeechEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="国内常见报数节奏" Description="自然语音报数，末 10 秒逐秒；无感无滴、有感单滴、破坏风险双滴">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.UseRecordedCountdown}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="允许双语音" Description="信息解说与短促报数分工；最后十秒只保留报数">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.AllowConcurrentSpeech}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="震情信息音色">
                    <ui:SettingsExpanderItem.Footer><ComboBox Width="260" ItemsSource="{Binding Voices}" SelectedItem="{Binding Settings.InformationVoice}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="备用合成报数音色" Description="关闭固定离线报数时使用">
                    <ui:SettingsExpanderItem.Footer><ComboBox Width="260" ItemsSource="{Binding Voices}" SelectedItem="{Binding Settings.CountdownVoice}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="预警时将音量调至最大" Description="默认开启；静音、撤销或关闭预警后恢复。演练不接管系统音量">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.BoostVolume}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="暂停其他媒体并静音其他应用" Description="默认开启；结束后恢复原静音状态，已暂停的媒体由你手动继续">
                    <ui:SettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding Settings.SuppressOtherAudio}"/></ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <TextBlock Text="{Binding Settings.AudioStatus}" Margin="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Settings.SpeechStatus}" Margin="12" TextWrapping="Wrap"/>

                <ui:SettingsExpanderItem Content="播报阈值"
                                         Description="与提醒阈值相互独立">
                    <ui:SettingsExpanderItem.Footer>
                        <NumericUpDown Width="150"
                                       Value="{Binding Settings.SpeechThreshold}"
                                       Minimum="0" Maximum="12"
                                       Increment="0.1"
                                       FormatString="0.0"
                                       IsEnabled="{Binding Settings.IsSpeechEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="预警动作"
                                 Margin="0"
                                 IconSource="Code"
                                 Description="{Binding Settings.ActionStatus}">
                <ui:SettingsExpanderItem Content="执行 CMD 命令"
                                         Description="每个地震事件执行一次">
                    <ui:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsCommandEnabled}" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="命令">
                    <ui:SettingsExpanderItem.Footer>
                        <TextBox Width="260"
                                 Text="{Binding Settings.Command}"
                                 IsEnabled="{Binding Settings.IsCommandEnabled}"
                                 Watermark="例如: shutdown /s /t 60" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <TextBlock Text="调试与测试"
                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,4" />
            <Grid ColumnDefinitions="*,Auto" Margin="12,8">
                <TextBlock Text="演练影响等级" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="220" ItemsSource="{Binding DrillOptions}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding Settings.DrillProfile}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <ui:SettingsExpander Header="{Binding Settings.DrillButtonText}"
                                 Margin="0"
                                 IconSource="Play"
                                 Description="模拟单源待核验、两接口吻合、全屏与语音；屏蔽外部命令，可随时停止"
                                 ActionIconSource="ChevronRight"
                                 IsClickEnabled="True"
                                 x:Name="btnExample"
                                 Click="btnExample_Click" />
        </StackPanel>
    </ScrollViewer>
</ci:NotificationProviderControlBase>
